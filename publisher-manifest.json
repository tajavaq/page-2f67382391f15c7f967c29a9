px}\n  .hero-notes {list-style: none;padding: 0;margin: 24px 0 0;display: grid;gap: 8px;font-size: 15px}\n  .hero-notes li::before {content: \"—\";color: var(--wine-soft);margin-right: 10px}\n\n  /* 时间线 */\n  .timeline {position: relative;margin: 0;padding: 0 0 0 26px;list-style: none;border-left: 1px solid var(--line)}\n  .timeline li {position: relative;padding: 0 0 26px 0;margin: 0}\n  .timeline li:last-child {padding-bottom: 0}\n  .timeline li::before {content: \"\";position: absolute;left: -32px;top: 10px;width: 9px;height: 9px;background: var(--ivory);border: 2px solid var(--wine);transform: rotate(45deg)}\n  .timeline .step-no {display: block;font-size: 11px;letter-spacing: .28em;color: var(--wine-soft);margin-bottom: 4px}\n  .timeline h3 {font-size: 17px;color: var(--wine-deep);margin-bottom: 4px}\n  .timeline p {margin: 0;font-size: 15px;color: var(--ink-soft)}\n\n  section {padding: 62px 0}\n  section + section {border-top: 1px solid var(--line)}\n\n  .sec-head {margin-bottom: 34px;max-width: 62ch}\n  .sec-head .tag {font-size: 12px;letter-spacing: .28em;color: var(--wine-soft);display: block;margin-bottom: 10px}\n  .sec-head h2 {font-size: clamp(25px, 4vw, 34px);color: var(--wine-deep);margin-bottom: 12px}\n  .sec-head p {color: var(--ink-soft);margin: 0}\n\n  /* 票据卡片 */\n  .ticket {background: #fffdf8;border: 1px dashed var(--wine-soft);padding: 22px 22px 20px;position: relative}\n  .ticket::after {content: \"\";position: absolute;left: 22px;right: 22px;bottom: 52px;border-top: 1px dashed var(--line)}\n  .ticket .ticket-no {font-size: 11px;letter-spacing: .3em;color: var(--wine-soft);display: block;margin-bottom: 8px}\n  .ticket h3 {font-size: 20px;color: var(--wine-deep);margin-bottom: 6px}\n  .ticket .price {font-size: 26px;color: var(--wine);letter-spacing: .02em}\n  .ticket .price span {font-size: 13px;color: var(--ink-soft);letter-spacing: .06em}\n  .ticket .annual {font-size: 14px;color: var(--ink-soft);margin: 2px 0 18px}\n  .ticket ul {font-size: 15px;padding-left: 1.1em;margin: 0 0 20px}\n  .ticket .foot {display: flex;align-items: baseline;justify-content: space-between;gap: 12px;font-size: 12px;letter-spacing: .16em;color: var(--ink-soft);padding-top: 8px}\n  .ticket .cta {border-bottom: none;color: var(--wine);font-weight: 700}\n  .ticket .cta:hover {border-bottom: 1px solid var(--wine)}\n  .ticket.featured {background: var(--wine);border-color: var(--wine);color: #f7ece0}\n  .ticket.featured h3, .ticket.featured .price {color: #fff5e8}\n  .ticket.featured .ticket-no,\n  .ticket.featured .annual,\n  .ticket.featured .foot span {color: #e4c9bd}\n  .ticket.featured ul {color: #f7ece0}\n  .ticket.featured::after {border-top-color: rgba(255,240,225,.35)}\n  .ticket.featured .cta {color: #fff5e8}\n  .ticket.featured .cta:hover {border-bottom-color: #fff5e8}\n  .badge {display: inline-block;font-size: 11px;letter-spacing: .2em;padding: 2px 9px;border: 1px solid currentColor;margin-left: 8px;vertical-align: 3px}\n\n  /* 阶梯式套餐 */\n  .plans-stairs {display: grid;gap: 22px;align-items: start}\n  @media (min-width: 760px) {\n    .plans-stairs {grid-template-columns: repeat(3, minmax(0, 1fr))}\n    .plans-stairs > .step-1 {margin-top: 0}\n    .plans-stairs > .step-2 {margin-top: 26px}\n    .plans-stairs > .step-3 {margin-top: 52px}\n  }\n\n  .note-line {margin-top: 30px;font-size: 14px;color: var(--ink-soft);border-left: 2px solid var(--line);padding-left: 14px}\n\n  /* 使用说明 */\n  .usage {display: grid;gap: 22px}\n  @media (min-width: 720px) {\n    .usage {grid-template-columns: repeat(2, minmax(0, 1fr))}\n  }\n  .usage .ticket {padding-bottom: 22px}\n  .usage .ticket::after {display: none}\n  .usage h3 {font-size: 18px}\n  .usage p {margin: 0 0 10px;font-size: 15px;color: var(--ink-soft)}\n  .usage p:last-child {margin-bottom: 0}\n\n  /* 客户端说明 */\n  .clients {display: grid;gap: 18px}\n  @media (min-width: 720px) {\n    .clients {grid-template-columns: repeat(2, minmax(0, 1fr))}\n  }\n  .client-item {border: 1px dashed var(--wine-soft);padding: 18px 20px;background: #fffdf8}\n  .client-item h3 {font-size: 17px;color: var(--wine-deep);margin-bottom: 6px}\n  .client-item p {margin: 0;font-size: 15px;color: var(--ink-soft)}\n  .client-item .meta {display: block;font-size: 12px;letter-spacing: .2em;color: var(--wine-soft);margin-bottom: 8px}\n\n  /* FAQ 按主题分组 */\n  .faq-group {margin-bottom: 42px}\n  .faq-group:last-child {margin-bottom: 0}\n  .faq-group-head {display: flex;align-items: baseline;gap: 12px;border-bottom: 1px solid var(--line);padding-bottom: 8px;margin-bottom: 20px}\n  .faq-group-head .g-no {font-size: 12px;letter-spacing: .28em;color: var(--wine-soft)}\n  .faq-group-head h3 {font-size: 19px;color: var(--wine-deep);margin: 0}\n  .qa {border: 1px dashed var(--wine-soft);background: #fffdf8;padding: 16px 20px;margin-bottom: 14px}\n  .qa:last-child {margin-bottom: 0}\n  .qa h4 {font-size: 16px;color: var(--wine-deep);margin: 0 0 6px}\n  .qa p {margin: 0;font-size: 15px;color: var(--ink-soft)}\n\n  /* 收尾：页内跳转 */\n  .closing {background: var(--wine-deep);color: #f3e2d6;padding: 52px 0 58px}\n  .closing h2 {font-size: clamp(22px, 3.5vw, 30px);color: #fff5e8;margin-bottom: 14px}\n  .closing p {color: #dfc4b6;max-width: 60ch}\n  .closing-links {list-style: none;padding: 0;margin: 26px 0 0;display: flex;flex-wrap: wrap;gap: 10px 26px;font-size: 14px;letter-spacing: .12em}\n  .closing-links a {color: #fff5e8;border-bottom: 1px dashed rgba(255,245,232,.5)}\n  .closing-links a:hover {border-bottom-style: solid}\n\n  footer {background: var(--wine-deep);color: #c9ad9f;font-size: 12px;letter-spacing: .14em;padding: 0 0 34px}\n  footer .wrap {border-top: 1px solid rgba(255,245,232,.18);padding-top: 18px}\n\n  .anchor {scroll-margin-top: 18px}\n</style><div class=\"topbar\">\n  <div class=\"wrap topbar-inner\">\n    <span class=\"topbar-mark\">MaTrix</span>\n    <a href=\"#timeline\">来路</a>\n    <a href=\"#plans\">套餐清单</a>\n    <a href=\"#usage\">使用说明</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</div>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div class=\"hero-intro\">\n        <span class=\"kicker\">订阅前先读这一页</span>\n        <h1>MaTrix\n          <small>把方案写在纸上，再决定要不要</small>\n        </h1>\n        <p class=\"hero-lead\">这不是一个催你下单的页面。MaTrix 的做法是把能确定的事一件件列出来：分几步走、每档差在哪里、用起来要注意什么。读完再判断合不合适，比看完价格就付款更有用。</p>\n        <ul class=\"hero-notes\">\n          <li>三档方案，差别写在权益清单里，不做隐藏项。</li>\n          <li>价格与年付口径写在卡片上，看到什么就是什么。</li>\n          <li>常见问题按主题分组，找不到答案的疑问请直接向服务方确认。</li>\n        </ul>\n\n        <ol class=\"timeline anchor\" id=\"timeline\">\n          <li>\n            <span class=\"step-no\">第一步</span>\n            <h3>看清自己要什么</h3>\n            <p>先算设备数量和每月用量。一台电脑加一部手机，和一家人同时在线，落在完全不同的档位。</p>\n          </li>\n          <li>\n            <span class=\"step-no\">第二步</span>\n            <h3>再对照权益清单</h3>\n            <p>把每档的流量、设备数、节点类型逐条读一遍。清单比价格更能说明一档方案适合谁。</p>\n          </li>\n          <li>\n            <span class=\"step-no\">第三步</span>\n            <h3>确认接入方式</h3>\n            <p>手上有哪些客户端、系统版本是否够用，决定了你第一次使用顺不顺畅。</p>\n          </li>\n          <li>\n            <span class=\"step-no\">第四步</span>\n            <h3>按周期取舍</h3>\n            <p>月付适合先试，年付适合确定长期要用的人。两种口径都写在卡片上，自行比较。</p>\n          </li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"anchor\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"tag\">方案清单</span>\n        <h2>三档方案，一档一档往上走</h2>\n        <p>下面三张票据按档位递进排列。左边是入门，中间是主推，右边是给多人共用的团队档。每张卡都把权益写在明面上，请按你的实际用量对号入座。</p>\n      </div>\n\n      <div class=\"plans-stairs\">\n        <article class=\"ticket step-1\">\n          <span class=\"ticket-no\">票据 A · 入门</span>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<span> / 月</span></p>\n          <p class=\"annual\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>最多 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"foot\"><span>适合 1—2 人轻量使用</span><a class=\"cta\" href=\"#faq\">看对应问答</a></div>\n        </article>\n\n        <article class=\"ticket step-2 featured\">\n          <span class=\"ticket-no\">票据 B · 主推</span>\n          <h3>旗舰版<span class=\"badge\">推荐</span></h3>\n          <p class=\"price\">¥35<span> / 月</span></p>\n          <p class=\"annual\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>最多 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线，游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"foot\"><span>适合设备较多、看重线路的人</span><a class=\"cta\" href=\"#usage\">看使用说明</a></div>\n        </article>\n\n        <article class=\"ticket step-3\">\n          <span class=\"ticket-no\">票据 C · 团队</span>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<span> / 月</span></p>\n          <p class=\"annual\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>最多 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"foot\"><span>适合多人共用、需定制路由</span><a class=\"cta\" href=\"#clients\">看客户端说明</a></div>\n        </article>\n      </div>\n\n      <p class=\"note-line\">价格与权益以上述卡片为准；实际结算方式、可用性及定制路由细节，请向 MaTrix 服务方确认后再决定。</p>\n    </div>\n  </section>\n\n  <section id=\"usage\" class=\"anchor\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"tag\">使用说明</span>\n        <h2>拿到账号之后，按这四件事做</h2>\n        <p>顺序不要跳。前一步没确认，后一步容易白折腾。</p>\n      </div>\n\n      <div class=\"usage\">\n        <div class=\"ticket\">\n          <span class=\"ticket-no\">01</span>\n          <h3>先确认你的设备清单</h3>\n          <p>把要接入的设备数一遍，包括手机、电脑、平板，以及是否需要和家人共用。基础版 3 台、旗舰版 5 台、团队版 20 台，这个上限就是同时在线数。</p>\n          <p>设备数超过上限时，正确的做法是换档，而不是轮着登录。</p>\n        </div>\n        <div class=\"ticket\">\n          <span class=\"ticket-no\">02</span>\n          <h3>再估一个月的用量</h3>\n          <p>看视频、开视频会议、下载文件，消耗差别很大。100GB、300GB、1000GB 三档额度按你的日常习惯估一个月，宁愿高估也别卡在月中。</p>\n          <p>额度是按月计的，未用完的部分不会结转到下个月。</p>\n        </div>\n        <div class=\"ticket\">\n          <span class=\"ticket-no\">03</span>\n          <h3>配对客户端再登录</h3>\n          <p>先在设备上装好客户端，再填账号信息。客户端版本过旧时，常见表现是连接不上或者配置导入失败，先升级再重试。</p>\n          <p>具体支持哪些客户端，见下一节的说明。</p>\n        </div>\n        <div class=\"ticket\">\n          <span class=\"ticket-no\">04</span>\n          <h3>遇到问题按顺序排查</h3>\n          <p>第一步看客户端版本，第二步看在线设备数是否超限，第三步看当月流量是否用完，最后再看节点线路。</p>\n          <p>旗舰版与团队版可走优先工单或客户经理渠道反馈，基础版走常规工单。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"anchor\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"tag\">客户端</span>\n        <h2>客户端说明：按设备类型对号入座</h2>\n        <p>下面写的是使用姿势，不是下载入口。MaTrix 提供各平台的配置方式说明，具体客户端请从你设备所在系统的正规渠道获取。</p>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"client-item\">\n          <span class=\"meta\">桌面端 · 电脑</span>\n          <h3>Windows 与 macOS</h3>\n          <p>桌面端适合长期挂载。装好后导入配置，把开机自启和系统代理按需打开即可。多人共用的机器，注意别让在线设备数悄悄超过上限。</p>\n        </div>\n        <div class=\"client-item\">\n          <span class=\"meta\">移动端 · 手机与平板</span>\n          <h3>iOS 与 Android</h3>\n          <p>移动端以配置导入为主，建议只在一台主力设备上常驻。切换网络后如果没恢复，先断开再重连，不必反复改配置。</p>\n        </div>\n        <div class=\"client-item\">\n          <span class=\"meta\">路由器 · 家庭共用</span>\n          <h3>路由器接入</h3>\n          <p>把配置放在路由器上，可让家里多台设备共用一个出口，但请留意这仍会占用同时在线的设备额度，团队版 20 台上限更适合这种场景。</p>\n        </div>\n        <div class=\"client-item\">\n          <span class=\"meta\">团队场景 · 多人</span>\n          <h3>团队与定制路由</h3>\n          <p>团队版提供企业定制路由与专属客户经理。路由规则怎么划分、账号如何分配给成员，需在购买前与服务方逐条确认，避免上线后再调整。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"anchor\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"tag\">常见问题</span>\n        <h2>分三组回答：选购、使用、结算</h2>\n        <p>每组都是能直接拿去对照的问题。若你的情况不在其中，请以服务方的正式答复为准。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <div class=\"faq-group-head\">\n          <span class=\"g-no\">A 组</span>\n          <h3>选购</h3>\n        </div>\n        <div class=\"qa\">\n          <h4>基础版和旗舰版最实质的差别是什么？</h4>\n          <p>两处：流量额度从 100GB 提到 300GB，在线设备从 3 台提到 5 台；另外旗舰版有全节点原生流媒体解锁、IPLC 专线游戏加速优化和优先工单。如果你只是单人轻量使用，基础版足够。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>团队版一定要买吗？</h4>\n          <p>不一定。只有当在线设备接近或超过 5 台、并且有定制路由需求时，团队版才划算。它的 20 台设备和 1000GB 额度是为多人共用准备的。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>可以先月付再决定吗？</h4>\n          <p>可以。三档都提供月付与年付两种口径，年付价格分别是 ¥150、¥350、¥850。先用月付跑一个月，确认用量和线路都合适，再考虑年付更稳妥。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <div class=\"faq-group-head\">\n          <span class=\"g-no\">B 组</span>\n          <h3>使用</h3>\n        </div>\n        <div class=\"qa\">\n          <h4>同时在线设备数是怎么算的？</h4>\n          <p>按同一时间连着的设备数量算，而不是按你登录过的设备总数算。手机、电脑、平板各自计一台；在路由器上接入时，仍按占用额度处理。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>当月流量用完了会怎样？</h4>\n          <p>流量额度按月计算，用完后当月无法继续使用对应额度，需要等下一个计费周期重置，或按服务方给出的升级方式处理。未用完的额度不结转。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>客户端连不上，先查什么？</h4>\n          <p>按顺序来：先升级客户端到较新版本，再核对在线设备数是否超出上限，然后确认当月流量是否耗尽，最后才检查节点线路。绝大多数问题出在前两步。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <div class=\"faq-group-head\">\n          <span class=\"g-no\">C 组</span>\n          <h3>结算与支持</h3>\n        </div>\n        <div class=\"qa\">\n          <h4>年付价按什么口径算？</h4>\n          <p>基础版 ¥150 / 年、旗舰版 ¥350 / 年、团队版 ¥850 / 年，均为按年一次性支付的价格。具体支付方式与开票事项，以 MaTrix 服务方的正式说明为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>支持渠道有什么区别？</h4>\n          <p>基础版走常规工单；旗舰版可享 7×24 优先工单；团队版另有专属客户经理对接。渠道不同，响应顺序也不同，但同样的排查步骤对三档通用。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>定制路由需要提前准备什么？</h4>\n          <p>先把成员与设备的分组方式、各组的用途写清楚，再与服务方沟通。团队版的定制路由属于需要事先约定的内容，购买前确认比购买后调整省事得多。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"closing\">\n    <div class=\"wrap\">\n      <h2>读完了，回到你最关心的那一节</h2>\n      <p>这一页的作用是让你少走回头路。方案、说明、客户端、问答四节都在上面，按需跳回即可。</p>\n      <ul class=\"closing-links\">\n        <li><a href=\"#timeline\">回到来路</a></li>\n        <li><a href=\"#plans\">回到套餐清单</a></li>\n        <li><a href=\"#usage\">回到使用说明</a></li>\n        <li><a href=\"#clients\">回到客户端</a></li>\n        <li><a href=\"#faq\">回到常见问题</a></li>\n      </ul>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">MaTrix · 本页所列方案、价格与权益为页面信息，最终以服务方正式说明为准。</div>\n</footer>",
